---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Free infrastructure cost and management review with Amir Hossein Rassafi." />
    <meta property="og:title" content="Free Infrastructure Review | Amir Hossein Rassafi" />
    <meta property="og:description" content="A focused conversation about reducing infrastructure cost and simplifying operations." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://amir-h-rassafi.github.io/consultation/" />
    <link rel="canonical" href="https://amir-h-rassafi.github.io/consultation/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <title>Free Infrastructure Review | Amir Hossein Rassafi</title>
  </head>
  <body>
    <header class="topbar">
      <nav class="topnav" aria-label="Site navigation">
        <a href="/">Home</a>
        <a href="/blog/">Blog</a>
        <a href="/consultation/">Free Infra Review</a>
        <a class="subscribe social-media-items" data-link-id="gmail" href="https://mail.google.com/mail/?view=cm&fs=1&to=amir.rassafi@gmail.com" target="_blank" rel="noopener noreferrer">Contact</a>
      </nav>
    </header>

    <main>
      <section class="consultation-section" aria-labelledby="consultation-title">
        <div class="consultation-offer">
          <div class="consultation-copy">
            <p class="eyebrow">Free infrastructure review</p>
            <h1 id="consultation-title">Make your infrastructure cheaper and easier to run.</h1>
            <p>In a focused 30-minute conversation, we can look for cloud cost waste, operational bottlenecks, and reliability improvements.</p>
          </div>
          <form class="consultation-form" id="consultation-form">
            <p class="consultation-form-title">Open an email draft</p>
            <button class="action action--primary" type="submit">Book a free review</button>
          </form>
        </div>
      </section>
    </main>

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-15X1490YRK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-15X1490YRK');


      var trackedLinks = document.getElementsByClassName('social-media-items');
      for (var i = 0; i < trackedLinks.length; i++) {
        trackedLinks[i].addEventListener('click', function() {
          gtag('event', 'click', {
            event_category: 'Link Clicks',
            event_label: this.getAttribute('data-link-id')
          });
        });
      }
    </script>
    <script is:inline>
      document.getElementById('consultation-form').addEventListener('submit', function(event) {
        event.preventDefault();
        var subject = encodeURIComponent('Free infrastructure review');
        var body = encodeURIComponent('Hi Amir,\n\nI\x27d like to request a free infrastructure review.\n\nA little context:\n- Company or project:\n- Current infrastructure or cloud provider:\n- Main challenge:\n- Approximate monthly infrastructure spend (optional):\n\nBest,\n');
        gtag('event', 'consultation_email', { event_category: 'Consultation', event_label: 'free_infrastructure_review' });
        window.open('https://mail.google.com/mail/?view=cm&fs=1&to=amir.rassafi@gmail.com&su=' + subject + '&body=' + body, '_blank', 'noopener,noreferrer');
      });
    </script>
  </body>
</html>
