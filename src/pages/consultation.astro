---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A free, independent GCP cost and architecture review for GCC teams." />
    <meta property="og:title" content="Free Infrastructure Review | Amir Hossein Rassafi" />
    <meta property="og:description" content="A founder-led GCP review focused on immediate savings, resilient architecture, and ongoing control." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://amir-h-rassafi.github.io/consultation/" />
    <link rel="canonical" href="https://amir-h-rassafi.github.io/consultation/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <title>Free Infrastructure Review | Amir Hossein Rassafi</title>
  </head>
  <body>
    <header class="topbar">
      <nav class="topnav" aria-label="Site navigation">
        <a href="/">Home</a>
        <a href="/blog/">Blog</a>
        <a class="infra-review" href="/consultation/" aria-current="page">Free Infra Review</a>
        <a class="subscribe social-media-items" data-link-id="gmail" href="https://mail.google.com/mail/?view=cm&fs=1&to=amir.rassafi@gmail.com" target="_blank" rel="noopener noreferrer">Contact</a>
      </nav>
    </header>

    <main class="consultation-page">
      <section class="consultation-hero" aria-labelledby="consultation-title">
        <p class="eyebrow">Free 30-minute GCP infrastructure review</p>
        <h1 id="consultation-title">An independent second opinion on your GCP infrastructure.</h1>
        <p class="consultation-lede">Practical cost and architecture advice for GCC teams—without a cloud resale quota or managed-services contract.</p>
        <form class="consultation-actions" id="consultation-form">
          <button class="action action--primary" type="submit">Request a free review</button>
          <span>No pitch or obligation.</span>
        </form>
      </section>

      <section class="consultation-summary" aria-label="Review priorities">
        <article><strong>Lower GCP cost</strong><span>Find immediate savings.</span></article>
        <article><strong>Reduce risk</strong><span>Review regions, sovereignty, and resilience.</span></article>
        <article><strong>Ship faster</strong><span>Simplify delivery and operations.</span></article>
        <article><strong>Stay in control</strong><span>Improve governance and forecasting.</span></article>
      </section>

      <section class="consultation-details" aria-labelledby="quick-wins-title">
        <div>
          <p class="eyebrow">Fixed-scope and founder-led</p>
          <h2 id="quick-wins-title">Start with the GCP improvements worth making now.</h2>
        </div>
        <div>
          <p>Cost, architecture, region choice, latency, billing, security, and resilience are reviewed together—with quick wins prioritised first.</p>
          <p class="ai-note"><strong>Independent by design:</strong> recommendations follow your priorities, not a sales target. AI-assisted checks can reduce routine effort while senior review keeps decisions under control.</p>
        </div>
      </section>
    </main>

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7B9L2V5DRV"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7B9L2V5DRV');


      var trackedLinks = document.getElementsByClassName('social-media-items');
      var useMailApp = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
      if (useMailApp) {
        var contactLink = document.querySelector('[data-link-id="gmail"]');
        contactLink.href = 'mailto:amir.rassafi@gmail.com';
        contactLink.removeAttribute('target');
        contactLink.removeAttribute('rel');
      }
      for (var i = 0; i < trackedLinks.length; i++) {
        trackedLinks[i].addEventListener('click', function() {
          gtag('event', 'click', {
            event_category: 'Link Clicks',
            event_label: this.getAttribute('data-link-id')
          });
        });
      }
    </script>
    <script is:inline>
      document.getElementById('consultation-form').addEventListener('submit', function(event) {
        event.preventDefault();
        var subject = encodeURIComponent('Free GCP infrastructure review');
        var body = encodeURIComponent('Hi Amir,\n\nI\x27d like to request a free GCP infrastructure review.\n\nA little context:\n- Company or project:\n- GCP regions or main workloads:\n- Main challenge:\n- Approximate monthly GCP spend (optional):\n\nBest,\n');
        gtag('event', 'consultation_email', { event_category: 'Consultation', event_label: 'free_gcp_infrastructure_review' });
        if (useMailApp) {
          window.location.href = 'mailto:amir.rassafi@gmail.com?subject=' + subject + '&body=' + body;
          return;
        }
        window.open('https://mail.google.com/mail/?view=cm&fs=1&to=amir.rassafi@gmail.com&su=' + subject + '&body=' + body, '_blank', 'noopener,noreferrer');
      });
    </script>
  </body>
</html>
